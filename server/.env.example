# Connection string Neon (pakai yang "pooled")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Wajib diganti: string acak panjang (contoh: openssl rand -hex 32)
JWT_SECRET=ganti-dengan-string-acak-panjang
IP_SALT=ganti-dengan-string-acak-lain

PORT=4000
NODE_ENV=development

# Origin frontend React (pisahkan dengan koma kalau lebih dari satu)
CLIENT_ORIGIN=http://localhost:5173

# Admin pertama, dibuat saat `npm run migrate`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@contoh.com
ADMIN_PASSWORD=ganti-password-admin
