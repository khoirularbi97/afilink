# Kosongkan kalau frontend & backend satu domain (disarankan, lewat Nginx)
VITE_API_URL=
# Domain link pendek yang dibagikan, mis. https://scurebot.site
VITE_SHORT_BASE=https://scurebot.site
# Di domain pendek khusus (mis. s.scurebot.site) set ke / supaya link jadi
# s.scurebot.site/slug tanpa /go/. Kalau berbagi domain dengan aplikasi, biarkan /go/.
VITE_SHORT_PREFIX=/go/
